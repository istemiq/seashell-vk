# Скопируй в `.env.production` в этом же каталоге и подставь домен перед `npm run build`.
# Vite загрузит её автоматически при сборке (MODE=production).
#
# Пример без /api (клиент сам добавляет /api):
VITE_API_URL=https://YOUR-HTTPS-API-HOST.DOMAIN.TLD

# Или уже с суффиксом:
# VITE_API_URL=https://YOUR-HTTPS-API-HOST.DOMAIN.TLD/api
