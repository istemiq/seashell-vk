# Скопируй в server/.env (или общий seashell/.env — см. load-env.js).
# Не коммить файлы с секретами.

# --- Обязательно в production ---
NODE_ENV=production

# PostgreSQL (словарь, группы, слова)
DATABASE_URL=

# Защищённое соединение с GigaChat
GIGACHAT_API_KEY=
# Модель для чата (словарь, практика)
GIGACHAT_MODEL_NAME=GigaChat-Max

# Температура генерации словаря (0–2). По умолчанию 0.38, если не задано.
GIGACHAT_WORD_TEMPERATURE=0.38

# VK: секрет приложения (Настройки → Работа с API). Обязательно для прода —
# иначе API доверяет только заголовку X-VK-User-Id (любой сможет подставить чужой id).
# Фронт в WebView отправляет заголовок X-VK-Launch-Params со строкой launch params (vk_sign проверяется).
# Должен совпадать с секретом приложения 54526886 в dev.vk.com — иначе даже реальные пользователи получат 401.
VK_APP_SECRET=

# Синтетический vk_user_id для робота проверки деплоя VK (GET /api/words|sets с *.vk-apps.com без подписи).
# Не привязывайте к реальному аккаунту — у этого id не должно быть личных данных в БД.
VK_REVIEWER_USER_ID=1

# HTTPS API на вашем домене (пример)
PORT=3001

# CORS: в production без списка браузерные запросы отклоняются.
# Обязательно: vk.com / m.vk.com (часть сценариев открытия мини-аппа).
# Хостинг фронта (*.vk-apps.com) разрешается кодом автоматически — в список не нужен.
#
# Пример (подстрой под фактический Origin во вкладке Network в DevTools):
CORS_ORIGINS=https://vk.com,https://m.vk.com,https://web.vk.com,https://vk.ru,https://m.vk.ru

# Опционально: TLS к GigaChat (в production по умолчанию строго; см. gigachat.js).
# Для локальной отладки: GIGACHAT_TLS_INSECURE=1
