# Скопируй в server/.env (или общий seashell/.env — см. load-env.js).
# Не коммить файлы с секретами.

# --- Обязательно в production ---
NODE_ENV=production

# PostgreSQL (словарь, группы, слова)
DATABASE_URL=

# --- LLM (практика, словарь, эксперты) ---
# deepseek — прямой API; openrouter — если IP не блокируется Cloudflare.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- OpenRouter (если LLM_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_APP_NAME=Seashell
# OPENROUTER_HTTP_REFERER=https://api.sishel.ru
# OPENROUTER_HTTP_PROXY=http://user:pass@host:port

# Температура генерации словаря (0–2). По умолчанию 0.38.
LLM_WORD_TEMPERATURE=0.38

# Глобальный кэш словаря: меняй версию, если существенно меняешь промпт/формат ответа.
LLM_DICTIONARY_CACHE_VERSION=v1

# Очередь LLM-запросов. Для однопоточной подписки оставь concurrency=1.
LLM_QUEUE_CONCURRENCY=1
LLM_QUEUE_MIN_INTERVAL_MS=1500
LLM_QUEUE_MAX_SIZE=50

# VK: секрет приложения (Настройки → Работа с API). Обязательно для прода —
# иначе API доверяет только заголовку X-VK-User-Id (любой сможет подставить чужой id).
# Фронт в WebView отправляет заголовок X-VK-Launch-Params со строкой launch params (vk_sign проверяется).
# Должен совпадать с секретом приложения 54526886 в dev.vk.com — иначе даже реальные пользователи получат 401.
VK_APP_SECRET=

# Telegram Mini App (@BotFather). Проверка X-Telegram-Init-Data на API.
TELEGRAM_BOT_TOKEN=

# Stars billing: webhook secret (X-Telegram-Bot-Api-Secret-Token) и подпись invoice payload.
# TELEGRAM_WEBHOOK_SECRET=random-long-string
# BILLING_PAYLOAD_SECRET=random-long-string
# STARS_SUBSCRIPTION_AMOUNT=145
# STARS_SUBSCRIPTION_DAYS=30
# SUBSCRIPTION_CREDITS=120
# STARS_TOPUP_AMOUNT=69
# TOPUP_CREDITS=60
# Ручной premium без оплаты (админы/тест): comma-separated Telegram user ids.
# PREMIUM_USER_IDS=

# Макс. возраст initData в секундах (по умолчанию 3600). 0 = не проверять.
TELEGRAM_INIT_DATA_MAX_AGE_SEC=3600

# Только dev: localhost-фронт → API без initData. В production игнорируется кодом.
TELEGRAM_ALLOW_LOCALHOST_HEADER=0

# Ежедневный отчёт только владельцу (cron на VPS). Chat id = ваш Telegram user id после /start у бота.
TELEGRAM_STATS_CHAT_IDS=

# localhost-фронт → prod API без initData (только dev):
# TELEGRAM_ALLOW_LOCALHOST_HEADER=1

# Синтетический vk_user_id для робота проверки деплоя VK (GET /api/words|sets с *.vk-apps.com без подписи).
# Не привязывайте к реальному аккаунту — у этого id не должно быть личных данных в БД.
VK_REVIEWER_USER_ID=1

# HTTPS API на вашем домене (пример)
PORT=3001

# CORS: в production без списка браузерные запросы отклоняются.
# Обязательно: vk.com / m.vk.com (часть сценариев открытия мини-аппа).
# Хостинг фронта (*.vk-apps.com) разрешается кодом автоматически — в список не нужен.
#
# Пример (подстрой под фактический Origin во вкладке Network в DevTools):
CORS_ORIGINS=https://vk.com,https://m.vk.com,https://web.vk.com,https://vk.ru,https://m.vk.ru

# Статистика использования (админ): GET /api/admin/stats, заголовок Authorization: Bearer <token>
# На VPS без HTTP: node server/scripts/usage-stats.mjs
ADMIN_STATS_TOKEN=
# Доп. user id для исключения из счётчиков (бот проверки — VK_REVIEWER_USER_ID)
# ADMIN_EXCLUDE_USER_IDS=826648841,497039245
