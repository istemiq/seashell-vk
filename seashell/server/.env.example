# Можно положить как server/.env, так и seashell/.env (корень проекта) — подхватываются оба; при совпадении имён важнее server/.env.
# Скопируй этот файл в .env. Не коммить .env.
# GigaChat: ключ авторизации Basic (как в личном кабинете GigaChat / документации)
GIGACHAT_API_KEY=
GIGACHAT_MODEL_NAME=GigaChat-Max

PORT=3001

# PostgreSQL (обязательно для API словаря)
# Локально (пример): DATABASE_URL=postgresql://seashell:seashell@localhost:5432/seashell
DATABASE_URL=

# VK Mini App: секрет приложения (из кабинета VK). Если задан — API проверяет подпись launch params (заголовок X-VK-Launch-Params).
# VK_APP_SECRET=

# Разрешённые origin для CORS (через запятую). В production без этого списка CORS будет заблокирован.
# Пример: CORS_ORIGINS=https://vk.com,https://m.vk.com
# CORS_ORIGINS=

# Опционально: 1 / 0 — принудительно ослабить или включить строгую проверку TLS к GigaChat.
# Если не задано: при NODE_ENV=production — строго; иначе (npm run dev) — для GigaChat уже ослаблено по умолчанию.
# GIGACHAT_TLS_INSECURE=1
