# Скопируй в файл .env в каталоге seashell (рядом с package.json). Не коммить.

# ── Деплой статики на VK Hosting ──
# Создай токен: https://dev.vk.ru/ru/access или настрой vk-miniapps-deploy.
# MINI_APPS_ACCESS_TOKEN=

# ── Сборка фронта под прод ──
# Указывать ДО выполнения: npm run build
# Абсолютный URL вашего HTTPS API без завершающего слэша (к /api добавится автоматически).
# Либо уже с суффиксом /api.
# Пример см. файл .env.production.example .

# Локально (dev): переменную не задаём — запросы идут на /api и проксируются Vite на порт 3001.
# VITE_API_URL=https://api.example.com

# Если тестируешь в браузере без параметров vk_user_id в URL:
# VITE_DEV_VK_USER_ID=1000001
