# Скопируй в файл .env рядом с package.json (сам .env в git не попадает).
# Токен для vk-miniapps-deploy (CI или ручной деплой):
# MINI_APPS_ACCESS_TOKEN=
#
# Бэкенд словаря (прод). Достаточно хоста или сразу с /api:
# VITE_API_URL=https://ИМЯ.beget.app
# VITE_API_URL=https://ИМЯ.beget.app/api
#
# Локальный тест в браузере без VK (опционально, по умолчанию 1000001):
# VITE_DEV_VK_USER_ID=1000001
