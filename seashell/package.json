{
  "name": "seashell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:api\" \"npm:start\"",
    "start": "vite",
    "start:tunnel": "set VITE_TUNNEL=1&& vite",
    "tunnel-local": "npx --yes localtunnel --port 5173",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tunnel": "vk-tunnel --http-protocol=http --host=localhost --port=5173",
    "deploy": "vite build && node scripts/vk-deploy.mjs",
    "deploy:prod": "vite build && node scripts/check-production-build.mjs && node scripts/deploy-prod.mjs",
    "verify:hosting": "node scripts/verify-hosting.mjs",
    "placement:show": "node scripts/placement-show.mjs",
    "api": "node server/index.js",
    "compose": "docker compose up --build",
    "compose:detach": "docker compose up --build -d"
  },
  "dependencies": {
    "@vkontakte/icons": "^3.1.1",
    "@vkontakte/vk-bridge": "^2.13.0",
    "@vkontakte/vk-bridge-react": "^1.0.1",
    "@vkontakte/vk-mini-apps-router": "^1.7.6",
    "@vkontakte/vkui": "^7.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "undici": "^6.25.0"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vkontakte/vk-miniapps-deploy": "^1.0.2",
    "@vkontakte/vk-tunnel": "^0.2.4",
    "concurrently": "^9.2.1",
    "eruda": "^3.0.1",
    "esbuild": "~0.20.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "terser": "^5.4.0",
    "vite": "^5.0.8"
  }
}
